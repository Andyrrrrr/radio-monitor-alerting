# Copy to /etc/vhfwatch/vhfwatch.env, then:
#   sudo chown root:vhfwatch /etc/vhfwatch/vhfwatch.env && sudo chmod 640 /etc/vhfwatch/vhfwatch.env
# NEVER commit the real file. Values are plain KEY=value (no "export", no quotes).

# Telegram bot (D26): token from @BotFather, chat id from getUpdates.
VHFWATCH_TELEGRAM_TOKEN=
VHFWATCH_TELEGRAM_CHAT_ID=

# Pushover, optional, only if [alerting] still lists "pushover" anywhere.
VHFWATCH_PUSHOVER_TOKEN=
VHFWATCH_PUSHOVER_USER=

# Tier 2 classifier. Leave empty to run keyword matching only.
VHFWATCH_ANTHROPIC_API_KEY=

# faster-whisper downloads its model on first run; keep that cache inside the
# service's own directory so the vhfwatch user can write it.
HF_HOME=/opt/vhfwatch/.cache/huggingface
